# Official lead-finder APIs (generate after the domain is ready). Do not scrape these sites.
APOLLO_API_KEY=
HUNTER_API_KEY=
BUILTWITH_API_KEY=
SNOV_API_KEY=

# Optional. FastAPI scrape uses Yellow Pages (no Google key required).
# Only the older CLI extract_leads.py still uses Places if you set this.
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Supabase (Project Settings → API)
# Use the service_role key for this local script only. Never commit it or put it in a frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail SMTP — for production outreach use Google Workspace on YOUR domain
# (hello@softenixsolution.com), not a free @gmail.com inbox. Then add SPF, DKIM, DMARC.
# Enable IMAP: Gmail Settings → See all settings → Forwarding and POP/IMAP
# Create an App Password at: https://myaccount.google.com/apppasswords
SENDER_EMAIL=hello@yourdomain.com
SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_HOST=imap.gmail.com
IMAP_MAILBOX=INBOX

# Display name shown in the From header
SENDER_NAME=Softenix Solution

# Local Ollama for FastAPI /generate-draft (model is hardcoded to llama3)
# Install: https://ollama.com  then: ollama pull llama3
# OLLAMA_HOST=http://127.0.0.1:11434

# OpenAI is only used by the older Python scripts (outreach.py, crew_email.py), not the API
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Follow-ups: Sent leads older than this many days get a bump
FOLLOWUP_AFTER_DAYS=3

# Safety limits — keep this low while the domain reputation is new
MAX_EMAILS_PER_RUN=20
MIN_DELAY_SECONDS=300
MAX_DELAY_SECONDS=600

# Live Gmail sends: 20/day during US Eastern business hours while the API is running.
AUTO_SEND=true

# Only save emails that sit on the business website domain (info@theirsite.com). Better leads, fewer spam traps.
REQUIRE_BUSINESS_EMAIL=true

# Tracking pixels often hurt inbox placement. Leave off unless PUBLIC_BASE_URL is a real https domain.
ENABLE_TRACKING=false

# Optional: reply-to and a simple unsubscribe mailbox
REPLY_TO_EMAIL=hello@softenixsolution.com
UNSUBSCRIBE_EMAIL=unsubscribe@softenixsolution.com

# Set to true to generate emails without sending
DRY_RUN=false

# FastAPI CORS (comma-separated). Localhost is already allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://softenix-outreach.vercel.app

# Public URL used in tracking pixels (must be reachable by the recipient's email client)
PUBLIC_BASE_URL=http://localhost:8000
